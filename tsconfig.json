{
    "compilerOptions": {
        "target": "ES2024",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "types": ["node"]
    },
    "include": [
        "*.ts",
        "key_map/**/*.ts",
        "test/**/*.ts",
        "tools/**/*.ts",
        "userword/**/*.ts",
        "utils/**/*.ts"
    ],
    "exclude": ["interface"]
}